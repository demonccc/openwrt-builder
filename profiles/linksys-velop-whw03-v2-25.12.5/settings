# Linksys Velop WHW03 V2 ImageBuilder settings.
#
# METHOD=imagebuilder uses the official prebuilt OpenWrt ImageBuilder instead
# of compiling OpenWrt from source.
#
# This profile is pinned to OpenWrt 25.12.5 for the ipq40xx/generic target.
# Update IMAGEBUILDER_URL when moving this profile to a newer release.

METHOD=imagebuilder
IMAGEBUILDER_URL=https://downloads.openwrt.org/releases/25.12.5/targets/ipq40xx/generic/openwrt-imagebuilder-25.12.5-ipq40xx-generic.Linux-x86_64.tar.zst
DEVICE=linksys_whw03v2
