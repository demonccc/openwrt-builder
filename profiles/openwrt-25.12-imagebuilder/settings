# OpenWrt ImageBuilder settings.
#
# METHOD=imagebuilder uses an official prebuilt ImageBuilder instead of
# compiling OpenWrt from source.
#
# This example is pinned to the latest 25.12 patch release available when the
# profile was created. Update IMAGEBUILDER_URL when a newer 25.12 release is used.

METHOD=imagebuilder
IMAGEBUILDER_URL=https://downloads.openwrt.org/releases/25.12.5/targets/x86/64/openwrt-imagebuilder-25.12.5-x86-64.Linux-x86_64.tar.zst
DEVICE=generic
